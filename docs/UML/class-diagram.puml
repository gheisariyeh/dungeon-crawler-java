@startuml

title Dungeon Crawler - Class Diagram (Iteration 7)

top to bottom direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false

' =========================================================
' Main application
' =========================================================

package "fr.campus.dungeoncrawler" as RootPackage {
    class "Main" as MainClass {
        +main(args: String[]): void
    }
}

' =========================================================
' Cell model
' =========================================================

package "fr.campus.dungeoncrawler.model.cell" as CellPackage {
    interface "Cell" as CellInterface {
        +interact(character: Character): void
    }

    class "EmptyCell" as EmptyCellClass {
        +interact(character: Character): void
    }
}

' =========================================================
' Characters
' =========================================================

package "fr.campus.dungeoncrawler.model.character" as CharacterPackage {
    abstract class "Character" as CharacterClass {
        -type: String
        -name: String
        -healthLevel: int
        -attackLevel: int
        -offensiveEquipment: OffensiveEquipment
        -defensiveEquipment: DefensiveEquipment
        +Character(type: String, name: String, healthLevel: int, attackLevel: int, offensiveEquipment: OffensiveEquipment, defensiveEquipment: DefensiveEquipment)
        +getName(): String
        +setName(name: String): void
        +getHealthLevel(): int
        +setHealthLevel(healthLevel: int): void
        +getAttackLevel(): int
        +getOffensiveEquipment(): OffensiveEquipment
        +setOffensiveEquipment(offensiveEquipment: OffensiveEquipment): void
        +toString(): String
    }
}

package "fr.campus.dungeoncrawler.model.character.types" as CharacterTypesPackage {
    class "Warrior" as WarriorClass {
        +Warrior(name: String)
    }

    class "Wizard" as WizardClass {
        +Wizard(name: String)
    }
}

' =========================================================
' Enemies
' =========================================================

package "fr.campus.dungeoncrawler.model.enemy" as EnemyPackage {
    class "Enemy" as EnemyClass {
        -name: String
        -lifePoints: int
        -strength: int
        +Enemy(name: String, lifePoints: int, strength: int)
        +getName(): String
        +getLifePoints(): int
        +setLifePoints(lifePoints: int): void
        +getStrength(): int
        +interact(character: Character): void
        +toString(): String
    }
}

package "fr.campus.dungeoncrawler.model.enemy.types" as EnemyTypesPackage {
    class "Dragon" as DragonClass {
        +Dragon()
    }

    class "Goblin" as GoblinClass {
        +Goblin()
    }

    class "Sorcerer" as SorcererClass {
        +Sorcerer()
    }
}

' =========================================================
' Defensive equipment
' =========================================================

package "fr.campus.dungeoncrawler.model.equipment.defensive" as DefensivePackage {
    abstract class "DefensiveEquipment" as DefensiveEquipmentClass {
        -type: String
        -defenseLevel: int
        -name: String
        +DefensiveEquipment(type: String, defenseLevel: int, name: String)
        +getDefenseLevel(): int
        +setDefenseLevel(defenseLevel: int): void
        +getName(): String
    }
}

package "fr.campus.dungeoncrawler.model.equipment.defensive.potion" as PotionPackage {
    class "Potion" as PotionClass {
        +Potion(defenseLevel: int, name: String)
        +interact(character: Character): void
    }

    class "StandardPotion" as StandardPotionClass {
        +StandardPotion()
        +interact(character: Character): void
    }

    class "LargePotion" as LargePotionClass {
        +LargePotion()
        +interact(character: Character): void
    }
}

package "fr.campus.dungeoncrawler.model.equipment.defensive.shield" as ShieldPackage {
    class "Shield" as ShieldClass {
        +Shield(defenseLevel: int, name: String)
        +interact(character: Character): void
    }

    class "SimpleShield" as SimpleShieldClass {
        +SimpleShield(type: String, defenseLevel: int, name: String)
        +interact(character: Character): void
    }
}

' =========================================================
' Offensive equipment
' =========================================================

package "fr.campus.dungeoncrawler.model.equipment.offensive" as OffensivePackage {
    abstract class "OffensiveEquipment" as OffensiveEquipmentClass {
        -type: String
        -attackLevel: int
        -name: String
        +OffensiveEquipment(type: String, attackLevel: int, name: String)
        +getAttackLevel(): int
        +setAttackLevel(attackLevel: int): void
        +getName(): String
    }
}

package "fr.campus.dungeoncrawler.model.equipment.offensive.weapon" as WeaponPackage {
    class "Weapon" as WeaponClass {
        +Weapon(attackLevel: int, name: String)
        +interact(character: Character): void
    }

    class "Club" as ClubClass {
        +Club()
        +interact(character: Character): void
    }

    class "Sword" as SwordClass {
        +Sword()
        +interact(character: Character): void
    }
}

package "fr.campus.dungeoncrawler.model.equipment.offensive.spell" as SpellPackage {
    class "Spell" as SpellClass {
        +Spell(attackLevel: int, name: String)
        +interact(character: Character): void
    }

    class "Fireball" as FireballClass {
        +Fireball()
        +interact(character: Character): void
    }

    class "Lightning" as LightningClass {
        +Lightning()
        +interact(character: Character): void
    }
}

' =========================================================
' Game classes
' =========================================================

package "fr.campus.dungeoncrawler.game" as GamePackage {
    class "Board" as BoardClass {
        -BOARD_SIZE: int
        -cells: ArrayList<Cell>
        +Board()
        +getCell(cellIndex: int): Cell
        +makeEmpty(cellIndex: int): void
    }

    class "Game" as GameClass {
        -menu: Menu
        -board: Board
        -movementDice: Dice
        -combatDice: Dice
        -characterPosition: int
        -character: Character
        +Game(menu: Menu, board: Board, movementDice: Dice, combatDice: Dice)
        +start(): void
        +startGame(): void
        +reStartGame(): void
        +changePosition(diceResult: int): void
        +changeReversePosition(diceResult: int): void
    }
}

' The package name below matches the current Java import:
' fr.campus.dungeoncrawler.game.Dice.Dice
package "fr.campus.dungeoncrawler.game.Dice" as DicePackage {
    interface "Dice" as DiceInterface {
        +roll(): int
    }

    class "SixSidedDice" as SixSidedDiceClass {
        -random: Random
        +roll(): int
    }

    class "TwentySidedDice" as TwentySidedDiceClass {
        -random: Random
        +roll(): int
    }
}

' =========================================================
' User interface
' =========================================================

package "fr.campus.dungeoncrawler.ui" as UiPackage {
    class "Menu" as MenuClass {
        -scanner: Scanner
        +Menu(scanner: Scanner)
        +displayMainMenu(): void
        +verifyChoice(): void
        +createCharacter(): Character
        +displayCharacter(character: Character): void
        +displaySecondMenu(): void
        +readChoiceMenu(): int
        +displayChangeName(): void
        +newName(): String
        +waitForEnter(): void
        +displayAttackMenu(): void
        +readAttackMenu(): int
        +displayThirdMenu(): void
    }
}

' =========================================================
' Exceptions
' =========================================================

class "Exception" as JavaException <<Java>>

package "fr.campus.dungeoncrawler.exception" as ExceptionPackage {
    class "OutOfBoardException" as OutOfBoardExceptionClass {
        +OutOfBoardException(message: String)
    }
}

' =========================================================
' Inheritance and interface implementation
' =========================================================

CellInterface <|.. EmptyCellClass
CellInterface <|.. EnemyClass
CellInterface <|.. DefensiveEquipmentClass
CellInterface <|.. OffensiveEquipmentClass

CharacterClass <|-- WarriorClass
CharacterClass <|-- WizardClass

EnemyClass <|-- DragonClass
EnemyClass <|-- GoblinClass
EnemyClass <|-- SorcererClass

DefensiveEquipmentClass <|-- PotionClass
PotionClass <|-- StandardPotionClass
PotionClass <|-- LargePotionClass

DefensiveEquipmentClass <|-- ShieldClass
ShieldClass <|-- SimpleShieldClass

OffensiveEquipmentClass <|-- WeaponClass
WeaponClass <|-- ClubClass
WeaponClass <|-- SwordClass

OffensiveEquipmentClass <|-- SpellClass
SpellClass <|-- FireballClass
SpellClass <|-- LightningClass

DiceInterface <|.. SixSidedDiceClass
DiceInterface <|.. TwentySidedDiceClass

JavaException <|-- OutOfBoardExceptionClass

' =========================================================
' Main dependencies
' =========================================================

MainClass ..> MenuClass : creates
MainClass ..> BoardClass : creates
MainClass ..> SixSidedDiceClass : creates
MainClass ..> TwentySidedDiceClass : creates
MainClass ..> GameClass : starts

' =========================================================
' Game associations and dependencies
' =========================================================

GameClass "1" --> "1" MenuClass : menu
GameClass "1" --> "1" BoardClass : board
GameClass "1" --> "1" CharacterClass : character
GameClass "1" --> "1" DiceInterface : movementDice
GameClass "1" --> "1" DiceInterface : combatDice

GameClass ..> EnemyClass : manages fights
GameClass ..> OffensiveEquipmentClass : handles pickup
GameClass ..> DefensiveEquipmentClass : handles consumption
GameClass ..> OutOfBoardExceptionClass : catches

' =========================================================
' Board, cells and character equipment
' =========================================================

BoardClass "1" *-- "64" CellInterface : cells

CharacterClass "1" --> "0..1" OffensiveEquipmentClass : offensiveEquipment
CharacterClass "1" --> "0..1" DefensiveEquipmentClass : defensiveEquipment

' =========================================================
' Method-level dependencies
' =========================================================

MenuClass ..> CharacterClass : creates / displays
CellInterface ..> CharacterClass : interact(character)

@enduml
